{
  "openapi": "3.1.0",
  "info": {
    "title": "VEFA Fraternal & Civic Community Platform API",
    "version": "2.4.0",
    "description": "Hardened REST API and Autonomous AI Agent Tool Calling Specification for American Civic & Fraternal Organizations.",
    "contact": {
      "name": "VEFA Platform Administrators",
      "email": "admin@vefa.club"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://yourlodge.org/api",
      "description": "Production Web Server"
    },
    {
      "url": "http://localhost:8080/api",
      "description": "Local WSL2 / Docker Development"
    }
  ],
  "paths": {
    "/health.php": {
      "get": {
        "summary": "System Health & Diagnostics",
        "description": "Returns runtime diagnostics, database status, and module health in real-time.",
        "responses": {
          "200": {
            "description": "Health status report"
          }
        }
      }
    },
    "/deposits.php": {
      "get": {
        "summary": "List $150 Hall Deposits or Generate Legal Rental Agreement",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["list", "contract"] }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deposit ledger or contract details" }
        }
      },
      "post": {
        "summary": "Record $150 Hall Reservation Deposit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_name": { "type": "string" },
                  "event_date": { "type": "string" },
                  "payment_method": { "type": "string" }
                },
                "required": ["client_name", "event_date"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Deposit registered successfully" }
        }
      }
    },
    "/exchange.php": {
      "get": {
        "summary": "List Community Exchange Listings",
        "responses": { "200": { "description": "List of active items" } }
      },
      "post": {
        "summary": "Create, Edit, or Delete Exchange Listing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "enum": ["create", "edit", "delete"] },
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Operation successful" } }
      }
    },
    "/twilio.php": {
      "post": {
        "summary": "Dispatch 24-hr Volunteer Shift Reminders via Twilio",
        "responses": { "200": { "description": "SMS reminders queued" } }
      }
    },
    "/calendar.php": {
      "get": {
        "summary": "iCalendar Feed (.ics)",
        "responses": { "200": { "description": "ICS formatted calendar event feed" } }
      }
    },
    "/scrape.php": {
      "post": {
        "summary": "Anti-Blocker Metadata Scraper with SSRF Filter",
        "responses": { "200": { "description": "Scraped metadata" } }
      }
    }
  }
}
