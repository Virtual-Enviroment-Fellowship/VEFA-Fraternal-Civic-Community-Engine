{
  "openapi": "3.1.0",
  "info": {
    "title": "VEFA: Fraternal & Civic Community Engine API",
    "version": "2.3.1",
    "description": "OpenAPI specification for the VEFA Platform including $150 Hall Deposits, Community Exchange, Charity Auctions, Twilio SMS Reminders, and Scraper.",
    "contact": { "email": "admin@vefa.club" }
  },
  "servers": [{ "url": "api/" }],
  "paths": {
    "/deposits.php": {
      "get": {
        "summary": "Retrieve Hall Rental Reservation Deposits Ledger",
        "responses": { "200": { "description": "List of active $150 reservation deposits" } }
      },
      "post": {
        "summary": "Record a $150 Hall Reservation Deposit",
        "responses": { "200": { "description": "Deposit confirmed" } }
      }
    },
    "/twilio.php": {
      "post": {
        "summary": "Dispatch SMS volunteer shift reminder",
        "responses": { "200": { "description": "SMS queued" } }
      }
    },
    "/scrape.php": {
      "post": {
        "summary": "Scrape website metadata with SSRF filter",
        "responses": { "200": { "description": "Ingested metadata" } }
      }
    },
    "/exchange.php": {
      "get": { "summary": "Get exchange listings" },
      "post": { "summary": "Create, edit, or delete exchange listing" }
    }
  }
}
